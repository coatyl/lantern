{
  "productName": "Lantern",
  "version": "0.1.0",
  "identifier": "dev.lantern.desktop",
  "build": {
    "frontendDist":       "../../ui/dist",
    "devUrl":             "http://localhost:5173",
    "beforeDevCommand":   "npm run dev -w lantern-ui",
    "beforeBuildCommand": "npm run build -w lantern-ui"
  },
  "app": {
    "windows": [
      {
        "title":       "Lantern",
        "width":        1200,
        "height":       800,
        "minWidth":     900,
        "minHeight":    600,
        "resizable":    true,
        "decorations":  false,
        "transparent":  false,
        "center":       true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active":  true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
