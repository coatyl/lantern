# Cargo and Tauri write here. Regenerable. Never commit.
# A local ship folder once lived at target/lantern-v1.0.0/; what it held
# is recorded in build/releases/README.md.
/target/

# npm workspaces (repo root and ui/)
node_modules/

# Bundled frontend output
dist/

# Playwright E2E output (report + per-run traces/screenshots)
ui/test-results/
ui/playwright-report/

# Tauri regenerates the ACL schema for whichever platform it builds on; only
# the Windows/desktop schemas are tracked, so ignore the per-host Linux one.
crates/lantern-app/gen/schemas/linux-schema.json

# OS junk
Thumbs.db
Desktop.ini
*.orig
